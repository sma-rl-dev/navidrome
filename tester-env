}

set_rating() { # <id> <stars> <label>
  local resp
  resp=$(subsonic setRating "id=$1&rating=$2")
  contains "${resp}" '"status":"ok"' || die "could not rate $3: ${resp}"
}

# Favourites and star ratings are per user, so they belong to the admin here.
seed_annotations() {
  login_token
  local item resp
  for item in "Blue Harbor" "Signal Bloom"; do
    resp=$(subsonic star "albumId=$(album_id "${item}")")
    contains "${resp}" '"status":"ok"' || die "could not star album ${item}: ${resp}"
  done
  for item in "Last Stop" "Riverbank" "First Snow"; do
    resp=$(subsonic star "id=$(song_id "${item}")")
    contains "${resp}" '"status":"ok"' || die "could not star song ${item}: ${resp}"
  done
  set_rating "$(album_id "Paper Lanterns")" 5 "album Paper Lanterns"
  set_rating "$(album_id "Tidal Works")" 4 "album Tidal Works"
  set_rating "$(album_id "Night Bus")" 3 "album Night Bus"
  set_rating "$(song_id "Salt & Smoke")" 4 "song Salt & Smoke"
  set_rating "$(song_id "Treeline")" 2 "song Treeline"
  log "seeded 5 stars and 5 ratings for admin"
}

seed_radio() { # <name> <streamUrl> <homePageUrl>
  local id body
  id=$(api "/radio" | json_pick name "$1" id)
  if [ -n "${id}" ]; then
    log "radio station $1 already exists"
    return 0
  fi
  body=$(python3 -c '
import json, sys
print(json.dumps({"name": sys.argv[1], "streamUrl": sys.argv[2],
                  "homePageUrl": sys.argv[3]}))
' "$1" "$2" "$3")
  id=$(json_id "$(api_post "/radio" "${body}")")
  [ -n "${id}" ] || die "could not create radio station $1"
  log "created radio station $1"
}

seed_radios() {
  login_token
  seed_radio "Night Drive FM" \
    "https://streams.example.net/night-drive-128.mp3" "https://example.net/night-drive"
  seed_radio "Sunday Classical" \
    "https://streams.example.net/sunday-classical-128.mp3" "https://example.net/sunday-classical"
}

# Fixed far-future expiry keeps the share visible without a wall-clock maximum.
seed_share() { # <description> <resourceIds> <downloadable>
  local id body
  id=$(api "/share" | json_pick description "$1" id)
  if [ -n "${id}" ]; then
    log "share $1 already exists"
    return 0
  fi
  body=$(python3 -c '
import json, sys
print(json.dumps({"description": sys.argv[1], "resourceIds": sys.argv[2],
                  "downloadable": sys.argv[3] == "true",
                  "expiresAt": "2030-12-31T00:00:00Z"}))
' "$1" "$2" "$3")
  id=$(json_id "$(api_post "/share" "${body}")")
  [ -n "${id}" ] || die "could not create share $1"
  log "created share $1"
}

seed_shares() {
  login_token
  seed_share "Night Bus (full album)" "$(album_id "Night Bus")" true
  seed_share "Late Night Drive playlist" \
    "$(api "/playlist" | json_pick name "Late Night Drive" id)" false
}

cmd_seed() {
  need_docker
