# Triggers a full library scan through the Subsonic API (admin-only
# /rest/startScan.view). Plain-password auth keeps the call free of salt/token
# juggling. The folder watcher can start a scan of its own at the same time, so
# a rejected request is retried until the API accepts it.
start_scan() {
  local deadline=$((SECONDS + 30)) resp=""
  while [ "${SECONDS}" -lt "${deadline}" ]; do
    resp=$(curl -sS --max-time 15 \
      "${LOCAL_URL}/rest/startScan.view?u=${ADMIN_USER}&p=${ADMIN_PASS}&v=1.16.1&c=tester-env&f=json&fullScan=true") \
      || resp=""
    contains "${resp}" '"status":"ok"' && return 0
    sleep 1
  done
  die "scan request was rejected: ${resp}"
}

wait_for_tracks() {
  local deadline=$((SECONDS + 180)) tracks albums
  login_token
  while [ "${SECONDS}" -lt "${deadline}" ]; do
    tracks=$(api_count "/song")
    albums=$(api_count "/album")
    if [ "${tracks}" = "${EXPECTED_TRACKS}" ] && [ "${albums}" = "${EXPECTED_ALBUMS}" ]; then
      log "scan finished: ${tracks} tracks in ${albums} albums"
      return 0
    fi
    sleep 1
  done
  docker logs --tail 40 "${CONTAINER_NAME}" 2>&1 || true
  die "scan did not index ${EXPECTED_TRACKS} tracks in ${EXPECTED_ALBUMS} albums within 180s"
}

# Reads the scanned library once; ids are random per run, so everything that
# follows is looked up by stable names/titles.
load_library() {
  if [ -z "${SONGS_JSON}" ]; then
    ALBUMS_JSON=$(api "/album")
    SONGS_JSON=$(api "/song")
  fi
}

album_id() { printf '%s' "${ALBUMS_JSON}" | json_pick name "$1" id; }
song_id() { printf '%s' "${SONGS_JSON}" | json_pick title "$1" id; }

seed_user() { # <userName> <name> <email>
  local user="$1" name="$2" email="$3" id body
  id=$(api "/user" | json_pick userName "${user}" id)
  if [ -n "${id}" ]; then
    log "user ${user} already exists"
    return 0
  fi
  body=$(python3 -c '
import json, sys
user, name, email = sys.argv[1:4]
print(json.dumps({"userName": user, "name": name, "email": email,
                  "password": user, "isAdmin": False}))
' "${user}" "${name}" "${email}")
  id=$(json_id "$(api_post "/user" "${body}")")
  [ -n "${id}" ] || die "could not create user ${user}"
  log "created non-admin user ${user} (${name})"
}

seed_users() {
  login_token
  seed_user maya "Maya Chen" "maya.chen@sundialrecords.example"
  seed_user theo "Theo Alvarez" "theo.alvarez@sundialrecords.example"
}

# Playlists are recreated on every seed so name/comment/public/tracks always
# match this table exactly (createdAt is server time and is never asserted).
seed_playlist() { # <owner> <pass> <name> <comment> <public> <title>...
  local owner="$1" pass="$2" name="$3" comment="$4" public="$5"
  shift 5
  local count=$# id body ids
  login_as "${owner}" "${pass}"
  id=$(api "/playlist" | json_pick name "${name}" id)
  if [ -n "${id}" ]; then
    api_delete "/playlist/${id}" >/dev/null
  fi
  body=$(python3 -c '
import json, sys
name, comment, public = sys.argv[1:4]
print(json.dumps({"name": name, "comment": comment, "public": public == "true"}))
' "${name}" "${comment}" "${public}")
  id=$(json_id "$(api_post "/playlist" "${body}")")
  [ -n "${id}" ] || die "could not create playlist ${name}"
  ids=$(SONGS_JSON="${SONGS_JSON}" python3 -c '
import json, os, sys
songs = {s["title"]: s["id"] for s in json.loads(os.environ["SONGS_JSON"])}
titles = sys.argv[1:]
missing = [t for t in titles if t not in songs]
if missing:
    sys.exit("missing seeded songs: " + ", ".join(missing))
print(json.dumps({"ids": [songs[t] for t in titles]}))
' "$@") || die "could not resolve tracks for playlist ${name}"
  api_post "/playlist/${id}/tracks" "${ids}" >/dev/null
  log "seeded playlist ${name} (owner ${owner}, public=${public}, ${count} tracks)"
}

seed_playlists() {
  seed_playlist admin "${ADMIN_PASS}" "Late Night Drive" \
