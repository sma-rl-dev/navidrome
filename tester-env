# <album dir>|<cover colour>|<added mtime>
while IFS='|' read -r dir colour mtime; do
  mkdir -p "/music/$dir"
  ffmpeg -hide_banner -loglevel error -y -f lavfi \
    -i "color=c=$colour:s=600x600:d=1" -frames:v 1 "/music/$dir/folder.jpg" </dev/null
  touch -t "$mtime" "/music/$dir/folder.jpg"
done <<'ALBUMS'
