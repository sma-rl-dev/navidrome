  login_token
  load_library
  seed_users
  seed_playlists
  seed_annotations
  seed_radios
  seed_shares

  log "seed complete: ${EXPECTED_ALBUMS} albums / ${EXPECTED_TRACKS} tracks / ${EXPECTED_USERS} users / ${EXPECTED_PLAYLISTS} playlists / ${EXPECTED_RADIOS} radio stations / ${EXPECTED_SHARES} shares"
}

# API-level seed checks. These are the same rows the UI renders on
# /app/#/album, /app/#/song, /app/#/playlist, /app/#/radio, /app/#/share,
# /app/#/user and the Starred / Top Rated album lists.
cmd_verify() {
  need_docker
  require_running
  local resp albums tracks artists first starred top_rated starred_songs
  local longest playlists maya_playlists users radios shares

  log "checking deterministic admin login (${ADMIN_USER}/${ADMIN_PASS})"
  login_token

  log "checking the seeded library through the native API"
  albums=$(api_count "/album")
  tracks=$(api_count "/song")
  artists=$(api_count "/artist")
  [ "${albums}" = "${EXPECTED_ALBUMS}" ] || die "/api/album returned ${albums} rows, expected ${EXPECTED_ALBUMS}"
  [ "${tracks}" = "${EXPECTED_TRACKS}" ] || die "/api/song returned ${tracks} rows, expected ${EXPECTED_TRACKS}"
  [ "${artists}" = "${EXPECTED_ARTISTS}" ] || die "/api/artist returned ${artists} rows, expected ${EXPECTED_ARTISTS}"
  log "api: ${albums} albums, ${tracks} tracks, ${artists} artists"

  resp=$(api "/album")
  for name in "Blue Harbor" "Northern Lines" "Low Ceilings" "Field Notes, Vol. 1" \
              "Night Bus" "Paper Lanterns" "Signal Bloom" "Tidal Works" \
              "Static Meridian" "The Quiet Cartographer"; do
    contains "${resp}" "\"name\":\"${name}\"" || die "album '${name}' is missing from /api/album"
  done
  log "all 10 album names are indexed"

  api "/artist" | python3 -c '
import json, sys
names = {a["name"] for a in json.load(sys.stdin)}
expected = {"Marina Vale", "Oslo Field", "Delta Groove",
            "Clara Voss & The Lantern Choir", "Clara Voss", "Static Meridian"}
missing = expected - names
if missing:
    sys.exit("missing artists: " + ", ".join(sorted(missing)))
' || die "artist names missing from /api/artist"

  resp=$(api "/genre")
  for name in Jazz Ambient Funk Folk Electronic; do
    contains "${resp}" "\"name\":\"${name}\"" || die "genre '${name}' is missing from /api/genre"
  done
  log "artists and genres present"

  api "/song" | python3 -c '
import json, sys
titles = {s["title"] for s in json.load(sys.stdin)}
expected = {"Low Tide", "White Noise Waltz", "Brass & Velvet", "Evening Service",
            "Corner Store", "Homewards", "Signal Bloom", "Harbourmaster",
            "Dead Air", "Contour Lines"}
missing = expected - titles
if missing:
    sys.exit("missing tracks: " + ", ".join(sorted(missing)))
' || die "track titles missing from /api/song"
  log "track titles from every album are indexed"

  # Album grouping: the double album has two discs, the rest one.
  api "/album" | python3 -c '
import json, sys
albums = {a["name"]: a for a in json.load(sys.stdin)}
multi = albums["Field Notes, Vol. 1"]
assert multi["songCount"] == 6, ("Field Notes songCount", multi["songCount"])
assert sorted(multi["discs"].keys()) == ["1", "2"], ("Field Notes discs", multi["discs"])
assert multi["genre"] == "Folk" and multi["maxYear"] == 2020, (multi["genre"], multi["maxYear"])
quiet = albums["The Quiet Cartographer"]
assert quiet["songCount"] == 3 and quiet["maxYear"] == 2025, (quiet["songCount"], quiet["maxYear"])
works = albums["Tidal Works"]
assert works["songCount"] == 6 and works["genre"] == "Jazz", (works["songCount"], works["genre"])
assert albums["Blue Harbor"]["albumArtist"] == "Marina Vale", albums["Blue Harbor"]["albumArtist"]
' || die "album metadata assertions failed"
  log "album metadata: double-disc Field Notes, Vol. 1 (6 tracks) + genres/years"

  # UI list contracts: recently added (fixed mtimes), Starred, Top Rated.
  first=$(api_get "/album" --data-urlencode '_sort=recently_added' --data-urlencode '_order=DESC' \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["name"])')
  [ "${first}" = "The Quiet Cartographer" ] || die "newest album is '${first}', expected 'The Quiet Cartographer'"

  starred=$(api_get "/album" --data-urlencode 'starred=true' \
    --data-urlencode '_sort=starred_at' --data-urlencode '_order=DESC' | json_sorted_list name)
  [ "${starred}" = "Blue Harbor,Signal Bloom" ] || die "starred albums: '${starred}'"

  top_rated=$(api_get "/album" --data-urlencode 'has_rating=true' \
    --data-urlencode '_sort=rating' --data-urlencode '_order=DESC' | json_list name)
  [ "${top_rated}" = "Paper Lanterns,Tidal Works,Night Bus" ] || die "top rated albums: '${top_rated}'"

  starred_songs=$(api_get "/song" --data-urlencode 'starred=true' | json_sorted_list title)
  [ "${starred_songs}" = "First Snow,Last Stop,Riverbank" ] || die "starred songs: '${starred_songs}'"
  log "list contracts: recentlyAdded=The Quiet Cartographer, starred=2 albums/3 songs, topRated order stable"

  longest=$(api_get "/song" --data-urlencode '_sort=duration' --data-urlencode '_order=DESC' \
    | python3 -c 'import json,sys; s=json.load(sys.stdin)[0]; print("%s %d" % (s["title"], int(s["duration"])))')
  contains "${longest}" "The Quiet Cartographer 570" || die "longest track: '${longest}', expected 'The Quiet Cartographer 570'"
  log "durations vary (longest: ${longest}s)"

  # Playlists: owner, public flag and exact track counts.
  playlists=$(api "/playlist" | python3 -c '
import json, sys
rows = json.load(sys.stdin)
print(";".join("%s|%s|%s|%s" % (p["name"], p["songCount"],
      "true" if p["public"] else "false", p["ownerName"])
      for p in sorted(rows, key=lambda p: p["name"])))
')
  [ "${playlists}" = "Focus Session|4|false|admin;Late Night Drive|5|true|admin;Shop Floor Rotation|4|true|theo;Sunday Morning|4|true|maya" ] \
    || die "admin playlists: '${playlists}'"
  log "admin sees 4 playlists incl. the private 'Focus Session'"

  login_as maya maya
  [ "${IS_ADMIN}" = false ] || die "maya should be a non-admin user"
  maya_playlists=$(api "/playlist" | json_sorted_list name)
  [ "${maya_playlists}" = "Late Night Drive,Shop Floor Rotation,Sunday Morning" ] \
    || die "maya playlists: '${maya_playlists}' (private admin playlist must be hidden)"
  log "maya sees 3 playlists (private admin playlist hidden)"

  login_as theo theo
  [ "${IS_ADMIN}" = false ] || die "theo should be a non-admin user"
  login_token

  users=$(api "/user" | json_sorted_list userName)
  [ "${users}" = "admin,maya,theo" ] || die "users: '${users}'"
  [ "$(api_count "/user")" = "${EXPECTED_USERS}" ] || die "/api/user does not return ${EXPECTED_USERS} rows"

  radios=$(api "/radio" | json_sorted_list name)
  [ "${radios}" = "Night Drive FM,Sunday Classical" ] || die "radio stations: '${radios}'"
  [ "$(api_count "/radio")" = "${EXPECTED_RADIOS}" ] || die "/api/radio does not return ${EXPECTED_RADIOS} rows"

  shares=$(api "/share" | python3 -c '
import json, sys
rows = json.load(sys.stdin)
print(";".join("%s|%s|%s" % (s["description"], s["resourceType"], s["contents"])
      for s in sorted(rows, key=lambda s: s["description"])))
')
  [ "${shares}" = "Late Night Drive playlist|playlist|Late Night Drive;Night Bus (full album)|album|Night Bus" ] \
    || die "shares: '${shares}'"
  [ "$(api_count "/share")" = "${EXPECTED_SHARES}" ] || die "/api/share does not return ${EXPECTED_SHARES} rows"
  log "users, radio stations and shares match"

  # The SPA shell must be served; browser-checker owns the actual UI proof.
  [ "$(body -o /dev/null -w '%{http_code}' "${LOCAL_URL}/app/")" = "200" ] \
    || die "/app/ is not served"
  log "UI shell served at ${LOCAL_URL}/app/"

  log "verify passed: admin login, ${albums} albums/${tracks} tracks/${artists} artists, ${EXPECTED_PLAYLISTS} playlists, ${EXPECTED_USERS} users, ${EXPECTED_RADIOS} radio, ${EXPECTED_SHARES} shares"
}

cmd_reset() {
  need_docker
  log "resetting environment"
  if container_exists; then
    docker stop --time 10 "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    docker rm "${CONTAINER_NAME}" >/dev/null
  fi
  local volume
  for volume in "${DATA_VOLUME}" "${MUSIC_VOLUME}"; do
    case "${volume}" in
      navidrome-data*|navidrome-music*)
        docker volume rm "${volume}" >/dev/null 2>&1 || true
        ;;
      *) die "refusing to remove unexpected volume ${volume}" ;;
    esac
  done
  log "reset complete (container and volumes removed; image kept for reuse)"
}

cmd_stop() {
  need_docker
  if container_running; then
    docker stop --time 10 "${CONTAINER_NAME}" >/dev/null
    log "stopped ${CONTAINER_NAME} (data preserved in ${DATA_VOLUME}/${MUSIC_VOLUME})"
  else
    log "container ${CONTAINER_NAME} is not running"
  fi
}

cmd_logs() {
  need_docker
  local tail_lines="${TAIL:-200}"
  local follow=""
  for arg in "$@"; do
    case "${arg}" in
      --follow|-f) follow="-f" ;;
      *) tail_lines="${arg}" ;;
    esac
  done
  docker logs --tail "${tail_lines}" ${follow} "${CONTAINER_NAME}" 2>&1 || die "no logs for ${CONTAINER_NAME}"
}

cmd_status() {
  echo "App: navidrome"
  echo "Image: ${IMAGE_NAME}"
  echo "Port: ${PORT} (container ${CONTAINER_PORT})"
  echo "URL: ${LOCAL_URL}/app/"
  echo "Container: ${CONTAINER_NAME}"
  echo "Volumes: ${DATA_VOLUME}:/data ${MUSIC_VOLUME}:/music"
  if container_running; then
    echo "Status: RUNNING"
    echo "Credentials: ${ADMIN_USER}/${ADMIN_PASS}"
  elif container_exists; then
    echo "Status: STOPPED"
  else
    echo "Status: NOT RUNNING"
  fi
}

cmd_help() {
  cat <<EOF
navidrome - Tester Environment CLI

Usage: ./tester-env <command> [--run-id <id>] [--port <port>]

Commands:
  deploy    Build the upstream Dockerfile, start the container, prove the
            deterministic admin login (${ADMIN_USER}/${ADMIN_PASS})
  seed      Generate the deterministic library (10 tagged albums, 47 FLAC
            tracks, covers), run a full scan, then seed users, playlists,
            stars/ratings, radio stations and shares through /api and /rest;
            safe to re-run
  verify    Log in and assert the seeded library, playlists, users, radio,
            shares, list filters and that /app/ is served
  reset     Stop and remove the container and both run-scoped volumes
            (keeps the image)
  stop      Stop the container (data preserved); 'down' is an alias
  logs      Show container logs (TAIL=<n>, --follow)
  status    Show container/image/URL/credential state
  help      Show this help

Options:
  --run-id <id>   Scope container and volume names for parallel runs. Default: default
  --port <port>   Host port bound to container ${CONTAINER_PORT}. Default: ${CONTAINER_PORT}

Environment:
  IMAGE_TAG       Content-addressed image tag exported by scripts/rl-env
                  (default: tester-env-navidrome:dev)
  RUN_ID          Run id; scopes container + volumes, never the image name
  PORT            Host port (same as --port)

Determinism:
  deploy sets ND_ENABLEEXTERNALSERVICES=false (no insights/agents/remote login
  background), ND_AUTHREQUESTLIMIT=0, ND_PLUGINS_ENABLED=false,
  ND_DEVAUTOCREATEADMINPASSWORD=admin (admin/admin exists before the UI's
  create-admin wizard) and ND_RECENTLYADDEDBYMODTIME=true with fixed fixture
  mtimes so "recently added" ordering is stable. TZ=UTC.

Seed data (baseline, ordinary app writes only):
  - admin / admin (admin), maya / maya and theo / theo (non-admin).
  - Library "Sundial Records": 10 albums / 47 tracks / 6 album artists /
    Jazz, Ambient, Funk, Folk, Electronic / 2017-2025, one double-disc album
    ("Field Notes, Vol. 1"), varied durations up to 9:30.
  - 4 playlists: Late Night Drive (admin, public, 5 tracks), Sunday Morning
    (maya, public, 4), Focus Session (admin, private, 4), Shop Floor Rotation
    (theo, public, 4).
  - admin favourites: albums Blue Harbor + Signal Bloom, songs Last Stop +
    Riverbank + First Snow; album ratings Paper Lanterns 5, Tidal Works 4,
    Night Bus 3; song ratings Salt & Smoke 4, Treeline 2.
  - 2 radio stations (Night Drive FM, Sunday Classical) and 2 shares
    (Night Bus album, Late Night Drive playlist; expiry fixed 2030-12-31).
  Ids are random per run; every seed step looks rows up by name, so re-running
  seed is idempotent.

Seed and reset:
  - The library is generated by the image's ffmpeg at seed time: fixed tags,
    fixed mtimes (2025-01..2025-10) and folder.jpg covers. Seed then triggers
    /rest/startScan.view (fullScan=true) and waits for 47 tracks / 10 albums.
  - All state lives in /data (SQLite + WAL, cache, JWT secret). ./tester-env
    reset removes the container and every volume, so the next deploy is a
    fresh admin/admin database with an empty library.
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true

  local passthrough=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-id)
        [ $# -ge 2 ] || die "--run-id requires a value"
        RUN_ID="$2"
        shift 2
        ;;
      --port)
        [ $# -ge 2 ] || die "--port requires a value"
        PORT="$2"
        shift 2
        ;;
      --help|-h)
        cmd_help
        exit 0
        ;;
      *)
        passthrough+=("$1")
        shift
        ;;
    esac
  done

  refresh_names

  case "${cmd}" in
    deploy) cmd_deploy ;;
    seed) cmd_seed ;;
    verify) cmd_verify ;;
    reset) cmd_reset ;;
    stop|down) cmd_stop ;;
    logs) cmd_logs "${passthrough[@]+"${passthrough[@]}"}" ;;
    status) cmd_status ;;
    help|--help|-h) cmd_help ;;
    *)
      printf '==> ERROR: unknown command %s\n' "${cmd}" >&2
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
