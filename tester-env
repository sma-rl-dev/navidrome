#!/usr/bin/env bash
# tester-env CLI for Navidrome v0.64.2
# (101145742f4762164202cb4858c9126258bdc463, latest stable release).
#
# Runs the editable checkout in one Docker container, built from the upstream
# Dockerfile (UI stage: node:lts-alpine npm ci + vite build; Go stage:
# golang:1.27-alpine CGO build; final: alpine:3.22 with ffmpeg/mpv/sqlite/
# libwebp). No prebuilt image and no external service: SQLite and the cache
# live in /data, the library is the /music mount.
#
# Ports/state:
#   host port ${PORT:-53812} -> container 4533 (ND_PORT in the image)
#   navidrome-data<run-id>  -> /data  (navidrome.db + WAL, cache, JWT secret)
#   navidrome-music<run-id> -> /music (generated fixture albums)
#
# Deterministic credentials: admin / admin, created on the first start from
# ND_DEVAUTOCREATEADMINPASSWORD, so the create-admin wizard never appears.
# External services are off (insights/agents/login background), auth rate
# limiting is off (agents log in repeatedly), plugins are off, and
# "recently added" sorts by file mtime so fixed fixture mtimes give a stable
# order.
#
# The library is ours: seed generates tagged FLAC albums with the image's
# ffmpeg (fixed metadata + fixed mtimes) plus folder covers, triggers a full
# scan, then writes users, playlists, stars/ratings, radio stations and shares
# through /api and /rest as ordinary app data. Reset = container + both volumes.
#
# All commands accept --run-id <id> and --port <port> because scripts/rl-env
# invokes them that way. RUN_ID scopes containers/volumes only; IMAGE_TAG scopes
# the image (content-addressed by rl-env, never run-id based).
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

RUN_ID="${RUN_ID:-default}"
PORT="${PORT:-53812}"
IMAGE_NAME="${IMAGE_TAG:-tester-env-navidrome:dev}"
DOCKERFILE="${SCRIPT_DIR}/Dockerfile"

CONTAINER_PORT=4533

ADMIN_USER="admin"
ADMIN_PASS="admin"

# Deterministic library ("Sundial Records" listening archive): 10 albums,
# 47 FLAC tracks, 6 album artists, 5 genres, 2017-2025, one double-disc album.
# Files carry fixed mtimes (2025-01-06 .. 2025-10-06) that drive "recently
# added"; no assertion depends on the wall clock.
EXPECTED_ALBUMS=10
EXPECTED_TRACKS=47
EXPECTED_ARTISTS=6
EXPECTED_PLAYLISTS=4
EXPECTED_USERS=3
EXPECTED_RADIOS=2
EXPECTED_SHARES=2

IS_ADMIN=false
TOKEN=""
ALBUMS_JSON=""
SONGS_JSON=""

SUFFIX=""
[ "${RUN_ID}" != "default" ] && SUFFIX="-${RUN_ID}"
CONTAINER_NAME="tester-env-navidrome${SUFFIX}"
DATA_VOLUME="navidrome-data${SUFFIX}"
MUSIC_VOLUME="navidrome-music${SUFFIX}"

LOCAL_URL="http://127.0.0.1:${PORT}"
LABELS=()

refresh_names() {
  SUFFIX=""
  [ "${RUN_ID}" != "default" ] && SUFFIX="-${RUN_ID}"
  CONTAINER_NAME="tester-env-navidrome${SUFFIX}"
  DATA_VOLUME="navidrome-data${SUFFIX}"
  MUSIC_VOLUME="navidrome-music${SUFFIX}"
  LOCAL_URL="http://127.0.0.1:${PORT}"
  LABELS=(
    --label "tester-env.project=${TESTER_ENV_PROJECT:-tester-env}"
    --label "tester-env.app=navidrome"
    --label "tester-env.scenario=${TESTER_ENV_SCENARIO:-manual}"
    --label "tester-env.run_id=${TESTER_ENV_RUN_ID:-${RUN_ID}}"
  )
}
refresh_names

log() { printf '==> %s\n' "$*"; }
die() { printf '==> ERROR: %s\n' "$*" >&2; exit 1; }

need_docker() {
  command -v docker >/dev/null 2>&1 || die "docker is required"
  command -v curl >/dev/null 2>&1 || die "curl is required"
  command -v python3 >/dev/null 2>&1 || die "python3 is required (JSON assertions)"
}

container_exists() {
  docker ps -a --filter "name=^/${CONTAINER_NAME}$" --format '{{.Names}}' | grep -qx "${CONTAINER_NAME}"
}

container_running() {
  docker ps --filter "name=^/${CONTAINER_NAME}$" --format '{{.Names}}' | grep -qx "${CONTAINER_NAME}"
}

require_running() {
  container_running || die "container ${CONTAINER_NAME} is not running; run './tester-env deploy' first"
}

body() { curl -sS --max-time 10 "$@" 2>/dev/null || true; }

# Case-based substring test: avoids the pipefail/SIGPIPE trap of `printf | grep -q`.
contains() {
  case "$1" in *"$2"*) return 0 ;; *) return 1 ;; esac
}

app_ready() {
  [ "$(body -o /dev/null -w '%{http_code}' "${LOCAL_URL}/ping")" = "200" ]
}

wait_for_app() {
  local deadline=$((SECONDS + 120))
  log "waiting for navidrome on ${LOCAL_URL}"
  while [ "${SECONDS}" -lt "${deadline}" ]; do
    if app_ready; then
      log "server is ready on ${LOCAL_URL}/app/"
      return 0
    fi
    if ! container_running; then
      docker logs --tail 60 "${CONTAINER_NAME}" 2>&1 || true
      die "container ${CONTAINER_NAME} exited before it answered"
    fi
    sleep 1
  done
  docker logs --tail 80 "${CONTAINER_NAME}" 2>&1 || true
  die "server did not answer within 120s"
}

# Logs in through POST /auth/login; sets TOKEN to the JWT and IS_ADMIN. Every
# native API call uses it as "X-ND-Authorization: Bearer <token>".
login_as() {
  local user="$1" pass="$2" resp
  resp=$(curl -sS --max-time 10 -X POST -H 'Content-Type: application/json' \
    -d "{\"username\":\"${user}\",\"password\":\"${pass}\"}" \
    "${LOCAL_URL}/auth/login") || die "login request failed"
  TOKEN=$(printf '%s' "${resp}" \
    | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
  [ -n "${TOKEN}" ] || die "login as ${user} failed: ${resp}"
  IS_ADMIN=false
  contains "${resp}" '"isAdmin":true' && IS_ADMIN=true
  return 0
}

login_token() {
  login_as "${ADMIN_USER}" "${ADMIN_PASS}"
  [ "${IS_ADMIN}" = true ] || die "login as ${ADMIN_USER} did not return an admin session"
}

api() { curl -sS --max-time 20 -H "X-ND-Authorization: Bearer ${TOKEN}" "${LOCAL_URL}/api$1"; }

# GET with query parameters (e.g. the UI's own list filters/sorts).
api_get() {
  local path="$1"
  shift
  curl -sS --max-time 20 -H "X-ND-Authorization: Bearer ${TOKEN}" --get \
    "${LOCAL_URL}/api${path}" "$@"
}

api_post() { # <path> <json body>
  curl -sS --max-time 20 -X POST -H "X-ND-Authorization: Bearer ${TOKEN}" \
    -H 'Content-Type: application/json' -d "$2" "${LOCAL_URL}/api$1"
}

api_delete() { # <path> -> HTTP status
  curl -sS --max-time 20 -o /dev/null -w '%{http_code}' -X DELETE \
    -H "X-ND-Authorization: Bearer ${TOKEN}" "${LOCAL_URL}/api$1"
}

# Subsonic call as the admin (plain password auth keeps it free of salt/token).
subsonic() { # <view> <query string>
  curl -sS --max-time 15 \
    "${LOCAL_URL}/rest/$1.view?u=${ADMIN_USER}&p=${ADMIN_PASS}&v=1.16.1&c=tester-env&f=json&$2"
}

# --- tiny JSON helpers (python3 only, no jq) --------------------------------

# First object in a JSON array whose <key> equals <value>, field <field>.
json_pick() { # <key> <value> <field>
  python3 -c '
import json, sys
rows = json.load(sys.stdin)
key, value, field = sys.argv[1:4]
for row in rows:
    if str(row.get(key, "")) == value:
        print(row.get(field, ""))
        break
' "$@"
}

# "id" of a create response object (empty when the body is not JSON).
json_id() {
  printf '%s' "${1:-}" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("id", ""))
except Exception:
    pass
'
}

# Comma-joined <field> values, API order.
json_list() { # <field>
  python3 -c '
import json, sys
rows = json.load(sys.stdin)
print(",".join(str(r.get(sys.argv[1], "")) for r in rows))
' "$1"
}

# Comma-joined <field> values, sorted.
json_sorted_list() { # <field>
  python3 -c '
import json, sys
rows = json.load(sys.stdin)
print(",".join(sorted(str(r.get(sys.argv[1], "")) for r in rows)))
' "$1"
}

# Row count of the JSON array returned by /api/<resource>.
api_count() {
  api "$1" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))'
}

cmd_deploy() {
  need_docker
  log "building image ${IMAGE_NAME} from ${DOCKERFILE}"
  # No run-scoped labels on the image: IMAGE_TAG is content-addressed and must
  # yield the same image ID for identical source across parallel runs.
  DOCKER_BUILDKIT=1 docker build -t "${IMAGE_NAME}" -f "${DOCKERFILE}" "${SCRIPT_DIR}"

  if container_exists; then
    log "replacing existing container ${CONTAINER_NAME}"
    docker stop --time 10 "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    docker rm "${CONTAINER_NAME}" >/dev/null
  fi

  log "starting ${CONTAINER_NAME} on port ${PORT}"
  docker run -d --name "${CONTAINER_NAME}" "${LABELS[@]}" \
    -e TZ=UTC \
    -e ND_ENABLEEXTERNALSERVICES=false \
    -e ND_AUTHREQUESTLIMIT=0 \
    -e ND_PLUGINS_ENABLED=false \
    -e ND_DEVAUTOCREATEADMINPASSWORD="${ADMIN_PASS}" \
    -e ND_RECENTLYADDEDBYMODTIME=true \
    -p "${PORT}:${CONTAINER_PORT}" \
    -v "${DATA_VOLUME}:/data" \
    -v "${MUSIC_VOLUME}:/music" \
    "${IMAGE_NAME}" >/dev/null

  wait_for_app
  login_token
  log "deployment complete: ${LOCAL_URL}/app/"

  log "login: ${ADMIN_USER}/${ADMIN_PASS}"
  log "next: ./tester-env seed, then ./tester-env verify"
}

# Writes the deterministic fixture library into the music volume with the
# image's ffmpeg. Re-seeding wipes only this volume. Tables are pipe-separated
# so album names may contain commas.
write_music_fixtures() {
  log "generating 10 tagged albums (47 FLAC tracks + folder.jpg) in ${MUSIC_VOLUME}"
  docker run --rm -i -e TZ=UTC --entrypoint sh -v "${MUSIC_VOLUME}:/music" "${IMAGE_NAME}" -s <<'SH'
